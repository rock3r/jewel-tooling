<idea-plugin>
  <id>dev.sebastiano.jewel.tooling</id>
  <name>Jewel Tooling</name>
  <vendor>Jewel Tooling</vendor>
  <description><![CDATA[
    Static Compose stability hints for Jewel and Compose UI authors.
    Shows parameter stability estimates and explanations in imported Gradle and Bazel projects.
    Static hints need no application instrumentation or build plugin.
    Import saved recordings from explicitly configured development targets.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.java</depends>
  <depends>org.jetbrains.kotlin</depends>
  <resource-bundle>messages.JewelToolingBundle</resource-bundle>
  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK1="false" supportsK2="true"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <codeInsight.lineMarkerProvider language="kotlin" implementationClass="dev.sebastiano.jewel.tooling.StabilityLineMarkerProvider"/>
    <codeInsight.declarativeInlayProvider
      language="kotlin"
      implementationClass="dev.sebastiano.jewel.tooling.StabilityInlayProvider"
      isEnabledByDefault="true"
      group="TYPES_GROUP"
      providerId="jewel.compose.stability"
      bundle="messages.JewelToolingBundle"
      nameKey="hints.name"
      descriptionKey="hints.description"/>
  </extensions>
  <actions>
    <action id="JewelTooling.OpenRecording" class="dev.sebastiano.jewel.tooling.OpenRecordingAction">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="JewelTooling.ShowStability" class="dev.sebastiano.jewel.tooling.ShowStabilityAction">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
